# Google Cloud OAuth 2.0 (Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Random 32+ byte secret; use 'openssl rand -base64 32'
AUTH_SECRET=

# Supabase Postgres, accessed only through the server-side Next.js API.
# Obtain these from Supabase Dashboard > Connect / Project Settings > API Keys.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# NEVER prefix the secret with NEXT_PUBLIC_ or put it into the native app.

# Optional: public canonical origin; otherwise inferred by Auth.js.
AUTH_URL=
