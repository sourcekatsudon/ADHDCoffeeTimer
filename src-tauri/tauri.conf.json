{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ADHD Coffee Time",
  "version": "0.1.0",
  "identifier": "com.sourcekatsudon.ambient-pomodoro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://adhd-coffee-focus.vercel.app; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "resources": {
      "sounds/seatbelt.wav": "sounds/seatbelt.wav",
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../licenses/": "licenses/"
    },
    "shortDescription": "A quiet desktop timer that starts itself when you work.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Japanese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "license": "MIT",
    "homepage": "https://github.com/sourcekatsudon/ADHDCoffeeTimer",
    "licenseFile": "../LICENSE"
  }
}
